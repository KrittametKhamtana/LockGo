# Copy to .env on the server (same directory as docker-compose.yml) and
# fill in real values. This file is never committed — it's the server-side
# equivalent of LockGo.Api/LockGo.Api/appsettings.Development.json.example.
#
# Two different consumers read this same file: `docker compose` itself
# (for the ${GITHUB_REPOSITORY_OWNER} substitution in docker-compose.yml)
# and the `api` container (via `env_file: .env`, everything below flows in
# as environment variables — ASP.NET Core's config binder maps the
# double-underscore names straight onto DatabaseOptions/JwtOptions with no
# code changes needed).

GITHUB_REPOSITORY_OWNER=your-github-username

Database__Host=CHANGE_ME
Database__Port=5432
Database__Database=lockgo
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__MaximumPoolSize=10
Database__SslMode=Require

Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_BYTES

AllowedOrigins__0=https://lockgo-app.duckdns.org
