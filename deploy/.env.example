# Copy to .env on the server (same directory as docker-compose.yml) and
# fill in real values. This file is never committed — it's the server-side
# equivalent of LockGo.Api/LockGo.Api/appsettings.Development.json.example.
#
# Consumed by the `api` container only (via `env_file: .env`) — everything
# below flows in as environment variables. ASP.NET Core's config binder
# maps the double-underscore names straight onto DatabaseOptions/JwtOptions
# with no code changes needed. (The image name/owner is hardcoded directly
# in docker-compose.yml, not templated from here — Docker image references
# must be all-lowercase, which GitHub usernames aren't guaranteed to be.)

Database__Host=CHANGE_ME
Database__Port=5432
Database__Database=lockgo
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__MaximumPoolSize=10
Database__SslMode=Require

Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_BYTES

# Must match the UI's actual origin exactly (scheme + host[:port], no
# trailing slash) or the browser blocks the API calls as CORS violations.
# Direct-IP mode (default, see docker-compose.yml): http://SERVER_IP:8080
# Domain mode (docker-compose.domain.yml): https://your-ui-name.duckdns.org
AllowedOrigins__0=http://CHANGE_ME_SERVER_IP:8080
